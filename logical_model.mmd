erDiagram
    SPECIALTIES ||--o{ CLINICIANS : specialty_id
    PATIENTS ||--o{ APPOINTMENTS : patient_id
    CLINICIANS ||--o{ APPOINTMENTS : clinician_id
    CLINICS ||--o{ APPOINTMENTS : clinic_id
    APPOINTMENTS ||--o{ DIAGNOSES : appointment_id
    APPOINTMENTS ||--o{ PRESCRIPTIONS : appointment_id
